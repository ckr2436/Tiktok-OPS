index 2bf539041..8d96f81d7 100644
--- a/tests/gateway/test_api_server.py
+++ b/tests/gateway/test_api_server.py
@@ -194,6 +194,59 @@ class TestIdempotencyCache:
         gate.set()
         assert await second == "response"

+    @pytest.mark.asyncio
+    async def test_rejected_result_is_shared_inflight_but_not_replayed(self):
+        cache = _IdempotencyCache()
+        gate = asyncio.Event()
+        started = asyncio.Event()
+        calls = 0
+
+        async def compute():
+            nonlocal calls
+            calls += 1
+            started.set()
+            await gate.wait()
+            return ({"failed": True, "error": "temporary"}, {})
+
+        should_store = lambda payload: not payload[0].get("failed", False)
+        first = asyncio.create_task(cache.get_or_set(
+            "idem-key", "fp-1", compute, should_store=should_store,
+        ))
+        second = asyncio.create_task(cache.get_or_set(
+            "idem-key", "fp-1", compute, should_store=should_store,
+        ))
+
+        await started.wait()
+        assert calls == 1
+        gate.set()
+        assert await first == await second
+
+        await cache.get_or_set(
+            "idem-key", "fp-1", compute, should_store=should_store,
+        )
+        assert calls == 2
+
+    @pytest.mark.asyncio
+    async def test_accepted_result_remains_cached_with_store_predicate(self):
+        cache = _IdempotencyCache()
+        calls = 0
+
+        async def compute():
+            nonlocal calls
+            calls += 1
+            return ({"final_response": "ok"}, {})
+
+        should_store = lambda payload: not payload[0].get("failed", False)
+        first = await cache.get_or_set(
+            "idem-key", "fp-1", compute, should_store=should_store,
+        )
+        second = await cache.get_or_set(
+            "idem-key", "fp-1", compute, should_store=should_store,
+        )
+
+        assert first == second
+        assert calls == 1
+

