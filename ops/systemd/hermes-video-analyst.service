[Unit]
Description=Hermes Video Analyst API Server for GMV Ops
After=network-online.target gmv-ai-gateway.service
Wants=network-online.target gmv-ai-gateway.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/hermes-agent
Environment=HERMES_HOME=/home/hermes/.hermes-video-analyst
Environment=API_SERVER_ENABLED=true
Environment=API_SERVER_HOST=127.0.0.1
Environment=API_SERVER_PORT=8647
Environment=API_SERVER_MODEL_NAME=gmv-ops-hermes-video-analyst
ExecStart=/home/hermes/hermes-agent/venv/bin/hermes gateway
Restart=always
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGTERM
LimitNOFILE=16384
TasksMax=128
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/hermes/.hermes-video-analyst /home/hermes/hermes-agent
MemoryHigh=384M
MemoryMax=640M

[Install]
WantedBy=multi-user.target
